# Optional: a currently available, original Anna's Archive domain.
# The scraper only reads public bibliographic metadata; it does not download books.
ANNAS_ARCHIVE_BASE_URL=https://annas-archive.gl
# Connect a PRIVATE Vercel Blob store to the project. Never prefix secrets with VITE_.
BLOB_READ_WRITE_TOKEN=
# Generate a random secret of at least 32 characters for the production cron route.
CRON_SECRET=
# Optional local cumulative catalog path (not used on Vercel).
CATALOG_PATH=.data/catalog.json
PORT=3001
